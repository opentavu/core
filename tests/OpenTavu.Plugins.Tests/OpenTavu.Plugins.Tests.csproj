<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Core plugins. net462, the plugins' own framework, so the tests run the code the Dataverse
       sandbox runs. Dataverse is an in-memory fake (Fakes/), never a live environment. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\_Shared\Common\OpenTavu.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- 2.8.2: the last runner that supports net462 (3.x needs net472). -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The same SDK version the plugins reference (packages.config). -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugins\Pl.Setup.Initialize\Pl.Setup.Initialize.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
