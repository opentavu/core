{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenTavu",
  "classifications": [ "Dataverse", "Plugin", "OpenTavu" ],
  "name": "OpenTavu Plugin (Pre-Op pattern)",
  "identity": "OpenTavu.Plugin",
  "shortName": "opentavu-plugin",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Pl.Entity.Action",
  "preferNameDirectory": true,
  "guids": [ "5D3C7A1E-8B42-4F6D-9E1A-2C7B4D8F0A31" ],
  "symbols": {
    "entityName": {
      "type": "parameter",
      "datatype": "string",
      "description": "Logical name of the Dataverse table (e.g., tavu_case, tavu_opportunity, account)",
      "isRequired": true,
      "replaces": "TAVU_ENTITY_LOGICAL_NAME",
      "fileRename": "tavu_entity"
    },
    "actionName": {
      "type": "parameter",
      "datatype": "string",
      "description": "Action category for the plugin (e.g., LifecycleTracker, ValidationGuard). Used as the class name.",
      "isRequired": true,
      "replaces": "ACTION_NAME_PLACEHOLDER",
      "fileRename": "Action"
    },
    "entityShortName": {
      "type": "parameter",
      "datatype": "string",
      "description": "Capitalized short entity name without the publisher prefix (e.g., Case, Opportunity, Account). Used only as part of the project name -n parameter.",
      "isRequired": true
    }
  },
  "primaryOutputs": [
    { "path": "Pl.Entity.Action.csproj" }
  ]
}